generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String // bcrypt hash
  wins      Int      @default(0)
  losses    Int      @default(0)
  elo       Int      @default(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gamesAsPlayer Player[]
}

model Game {
  id         String     @id @default(uuid())
  roomCode   String     @unique @default("")
  status     GameStatus @default(LOBBY)
  boardState Json? // The 19 hexes and layout structure
  gameState  Json? // Complete serialised Engine State (resources, turn, active robber)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  players Player[]
}

model Player {
  id       String   @id @default(uuid())
  userId   String? // Nullable specifically for AI Bots or Guests
  gameId   String
  color    String
  score    Int      @default(0)
  isBot    Boolean  @default(false)
  joinedAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
  game Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, color]) // One color per lobby constraint
}

enum GameStatus {
  LOBBY
  IN_PROGRESS
  FINISHED
}
